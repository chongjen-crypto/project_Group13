# =============================================================================
# Scholar Hub — Environment variables (copy to .env and fill in values)
# =============================================================================
# Never commit .env to version control.

# MySQL (prefer includes/db_local.php — or set here)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=facility_booking_system
DB_PORT=3306

# ToyyibPay (prefer config/toyyibpay_local.php — or set here)
TOYYIBPAY_SECRET_KEY=your-toyyibpay-user-secret-key
TOYYIBPAY_SANDBOX=true
# Category code pxf2xhg2 is set in config/toyyibpay.php (Facility Booking System)

# Optional SMTP (used by includes/mail_helper.php)
SCHOLARHUB_SMTP_USER=your@gmail.com
SCHOLARHUB_SMTP_PASS=your-app-password
SCHOLARHUB_SMTP_HOST=smtp.gmail.com
SCHOLARHUB_MAIL_FROM=your@gmail.com
SCHOLARHUB_MAIL_FROM_NAME=Scholar Hub
